{
  "name": "melnixdev/csv-duplicate-finder",
  "description": "Find connected duplicate records in CSV files using Union-Find.",
  "license": "GPL-3.0-only",
  "type": "project",
  "require": {
    "php": "^8.3"
  },
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "phpunit/phpunit": "^12.5"
  },
  "autoload": {
    "psr-4": {
      "MelnixDev\\CsvDuplicateFinder\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "MelnixDev\\CsvDuplicateFinder\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse --no-progress --debug",
    "check": [
      "@test",
      "@analyse"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
